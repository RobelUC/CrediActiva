# Copia este archivo a backend/.env y completa los valores.
# Supabase → Project Settings → Database → Connection string → URI
# Recomendado en Windows: "Transaction pooler" (puerto 6543).
# Si timeout con :5432, NO uses db.xxx.supabase.co:5432; usa el pooler.

SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Solo si el pooler no aplica en tu red:
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Opcional: URL distinta por servicio (sobrescribe SUPABASE_DATABASE_URL)
# AUTH_DATABASE_URL=
# CREDIT_DATABASE_URL=
# PAYMENT_DATABASE_URL=

# Consulta DNI (ApisPeru / RENIEC). En Windows si falla SSL:
# APISPERU_SSL_VERIFY=false
# APISPERU_TOKEN=tu_token_en_apisperu.com
